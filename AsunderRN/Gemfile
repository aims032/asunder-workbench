# Ruby gems needed to build the iOS app. The only one that matters is CocoaPods,
# which fetches and links the native iOS libraries. This is the standard
# React Native 0.88 Gemfile.
#
# Install once with:   bundle install --path vendor/bundle
source 'https://rubygems.org'
ruby ">= 2.6.10"
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'xcodeproj', '< 1.26.0'
gem 'concurrent-ruby', '< 1.3.4'
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
# ffi 1.17+ only ships ready-built files for Ruby 3; older versions build
# themselves on the Mac's built-in Ruby 2.6.
gem 'ffi', '< 1.17'
